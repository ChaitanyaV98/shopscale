{
  "name": "shopscale",
  "version": "1.0.0",
  "description": "Event-driven commerce backend: orders, inventory and payments that stay consistent under flash-sale load",
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "orders": "tsx src/services/orders/main.ts",
    "inventory": "tsx src/services/inventory/main.ts",
    "payments": "tsx src/services/payments/main.ts",
    "gateway": "tsx src/services/gateway/main.ts",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "loadtest": "bash scripts/loadtest.sh"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
